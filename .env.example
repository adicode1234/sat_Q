# ==============================================================================
# SatQuery AI - Environment Configuration Template
# Copy this file to .env and fill in your credentials before starting the server.
# ==============================================================================

# --- Core Pipeline Configuration ---
# 'legacy' uses the verified deterministic + neural multi-specialist pipeline.
SATQUERY_PIPELINE=legacy

# --- Cloud Vision AI Setup ---
# Set to 1 to enable multi-modal reasoning, 0 for offline heuristics.
SATQUERY_CLOUD_VISION=1
# Provider options: openrouter | gemini | ollama | novita
SATQUERY_VISION_PROVIDER=openrouter

# --- OpenRouter Vision Provider (Recommended for free/cheap high-tier VLM) ---
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# --- Google Gemini Vision Provider (Alternative) ---
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Supabase Authentication (User Accounts, Sign-in, Sign-up) ---
# Get your credentials at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# --- Server & Deployment Limits ---
HOST=0.0.0.0
PORT=8000
SATQUERY_MAX_UPLOADS=20
SATQUERY_MAX_UPLOAD_MB=128
SATQUERY_MAX_QUERY_CHARS=8000
SATQUERY_MAX_DECODED_MB=1024
